<resources>
    <!-- Compose draws everything; this only styles the window before the first frame. -->
    <style name="Theme.Ziri" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <!-- Context theme for WebViews only: a dark base so "Dark web pages" can work whatever the app/phone mode is. -->
    <style name="Theme.Ziri.Web" parent="android:Theme.Material.NoActionBar" />
    <style name="Theme.Ziri.WebLight" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
